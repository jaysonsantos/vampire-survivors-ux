<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build:   dotnet build -c Release                          (MelonLoader, default)
             dotnet build -c Release -p:Loader=BepInEx        (BepInEx IL2CPP)
    Paths:   -p:GamePath=...  -p:Il2CppAssembliesPath=...  -p:LoaderLibPath=...  -p:CopyToMods=false
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QuickRetry</AssemblyName>
    <RootNamespace>QuickRetry</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <Loader Condition="'$(Loader)' == ''">MelonLoader</Loader>
    <GamePath Condition="'$(GamePath)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Vampire Survivors</GamePath>
    <CopyToMods Condition="'$(CopyToMods)' == ''">true</CopyToMods>
  </PropertyGroup>

  <!-- MelonLoader layout -->
  <PropertyGroup Condition="'$(Loader)' == 'MelonLoader'">
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
    <LoaderLibPath Condition="'$(LoaderLibPath)' == ''">$(GamePath)/MelonLoader/net6</LoaderLibPath>
    <Il2CppAssembliesPath Condition="'$(Il2CppAssembliesPath)' == ''">$(GamePath)/MelonLoader/Il2CppAssemblies</Il2CppAssembliesPath>
    <ModsPath Condition="'$(ModsPath)' == ''">$(GamePath)/Mods</ModsPath>
  </PropertyGroup>

  <!-- BepInEx IL2CPP layout -->
  <PropertyGroup Condition="'$(Loader)' == 'BepInEx'">
    <DefineConstants>$(DefineConstants);BEPINEX</DefineConstants>
    <LoaderLibPath Condition="'$(LoaderLibPath)' == ''">$(GamePath)/BepInEx/core</LoaderLibPath>
    <Il2CppAssembliesPath Condition="'$(Il2CppAssembliesPath)' == ''">$(GamePath)/BepInEx/interop</Il2CppAssembliesPath>
    <ModsPath Condition="'$(ModsPath)' == ''">$(GamePath)/BepInEx/plugins</ModsPath>
  </PropertyGroup>

  <!-- MelonLoader prefixes the interop file names with Il2Cpp. BepInEx does not. Pick the file that exists. -->
  <PropertyGroup>
    <VsRuntimeDll Condition="Exists('$(Il2CppAssembliesPath)/Il2CppVampireSurvivors.Runtime.dll')">$(Il2CppAssembliesPath)/Il2CppVampireSurvivors.Runtime.dll</VsRuntimeDll>
    <VsRuntimeDll Condition="'$(VsRuntimeDll)' == ''">$(Il2CppAssembliesPath)/VampireSurvivors.Runtime.dll</VsRuntimeDll>
    <LocalizationDll Condition="Exists('$(Il2CppAssembliesPath)/Il2Cppl2localization.dll')">$(Il2CppAssembliesPath)/Il2Cppl2localization.dll</LocalizationDll>
    <LocalizationDll Condition="'$(LocalizationDll)' == ''">$(Il2CppAssembliesPath)/l2localization.dll</LocalizationDll>
    <PauseSystemDll Condition="Exists('$(Il2CppAssembliesPath)/Il2CppPauseSystem.dll')">$(Il2CppAssembliesPath)/Il2CppPauseSystem.dll</PauseSystemDll>
    <PauseSystemDll Condition="'$(PauseSystemDll)' == ''">$(Il2CppAssembliesPath)/PauseSystem.dll</PauseSystemDll>
    <RewiredCoreDll Condition="Exists('$(Il2CppAssembliesPath)/Il2CppRewired_Core.dll')">$(Il2CppAssembliesPath)/Il2CppRewired_Core.dll</RewiredCoreDll>
    <RewiredCoreDll Condition="'$(RewiredCoreDll)' == ''">$(Il2CppAssembliesPath)/Rewired_Core.dll</RewiredCoreDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Loader/MelonEntry.cs" Condition="'$(Loader)' == 'MelonLoader'" />
    <Compile Include="Loader/BepInExEntry.cs" Condition="'$(Loader)' == 'BepInEx'" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(LoaderLibPath)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(LoaderLibPath)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VampireSurvivors.Runtime"><HintPath>$(VsRuntimeDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="l2localization"><HintPath>$(LocalizationDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="PauseSystem"><HintPath>$(PauseSystemDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>$(RewiredCoreDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppAssembliesPath)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppAssembliesPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppAssembliesPath)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppAssembliesPath)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppAssembliesPath)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'MelonLoader'">
    <Reference Include="MelonLoader"><HintPath>$(LoaderLibPath)/MelonLoader.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx'">
    <Reference Include="BepInEx.Core"><HintPath>$(LoaderLibPath)/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(LoaderLibPath)/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(LoaderLibPath)/BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToGameMods" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true' And Exists('$(GamePath)')">
    <MakeDir Directories="$(ModsPath)" />
    <Copy SourceFiles="$(OutDir)/$(AssemblyName).dll" DestinationFolder="$(ModsPath)" />
    <Message Importance="high" Text="Copied $(AssemblyName).dll to $(ModsPath)" />
  </Target>

</Project>
